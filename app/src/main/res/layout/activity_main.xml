<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg_main" android:padding="8dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingBottom="6dp">
        <ImageView android:id="@+id/imgEmblem" android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_humayra_emblem" android:contentDescription="Logo" />
        <TextView android:id="@+id/tvName" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="HUMAYRA" android:singleLine="true" android:ellipsize="end" android:textColor="@color/text_primary"
            android:textSize="15sp" android:textStyle="bold" android:paddingStart="6dp" android:paddingEnd="4dp" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_pill_dark" android:padding="2dp" android:layout_marginEnd="5dp">
            <TextView android:id="@+id/tab3d" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingHorizontal="10dp" android:paddingVertical="4dp" android:text="3D" android:textColor="@color/text_primary" android:textSize="11sp" android:textStyle="bold" android:background="@drawable/bg_glow_button" />
            <TextView android:id="@+id/tabChat" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingHorizontal="10dp" android:paddingVertical="4dp" android:text="Chat" android:textColor="@color/text_secondary" android:textSize="11sp" />
        </LinearLayout>
        <TextView android:id="@+id/tvHealthBadge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_pill_dark" android:paddingHorizontal="7dp" android:paddingVertical="5dp" android:text="--%" android:textColor="@color/text_primary" android:textSize="10sp" android:layout_marginEnd="5dp" />
        <TextView android:id="@+id/btnMaster" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_pill_dark" android:paddingHorizontal="8dp" android:paddingVertical="5dp" android:text="⏻" android:textColor="@color/status_green" android:textSize="13sp" android:layout_marginEnd="5dp" />
        <TextView android:id="@+id/btnSettings" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_pill_dark" android:paddingHorizontal="8dp" android:paddingVertical="5dp" android:text="⚙" android:textColor="@color/text_primary" android:textSize="13sp" />
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <FrameLayout android:id="@+id/page3d" android:layout_width="match_parent" android:layout_height="match_parent">
            <ImageView android:id="@+id/imgStageWall" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:visibility="gone" />
            <WebView android:id="@+id/webStage" android:layout_width="match_parent" android:layout_height="match_parent" />
            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:scrollbars="none" android:paddingBottom="8dp">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingHorizontal="4dp">
                    <TextView android:id="@+id/btnPoseWave" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_pill_dark" android:paddingHorizontal="12dp" android:paddingVertical="6dp" android:text="Wave" android:textColor="@color/text_primary" android:textSize="11sp" android:layout_marginEnd="6dp" />
                    <TextView android:id="@+id/btnPoseSit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_pill_dark" android:paddingHorizontal="12dp" android:paddingVertical="6dp" android:text="Sit" android:textColor="@color/text_primary" android:textSize="11sp" android:layout_marginEnd="6dp" />
                    <TextView android:id="@+id/btnPoseStand" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_pill_dark" android:paddingHorizontal="12dp" android:paddingVertical="6dp" android:text="Stand" android:textColor="@color/text_primary" android:textSize="11sp" android:layout_marginEnd="6dp" />
                    <TextView android:id="@+id/btnPoseSmile" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_pill_dark" android:paddingHorizontal="12dp" android:paddingVertical="6dp" android:text="Smile" android:textColor="@color/text_primary" android:textSize="11sp" android:layout_marginEnd="6dp" />
                    <TextView android:id="@+id/btnPosePortrait" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_pill_dark" android:paddingHorizontal="12dp" android:paddingVertical="6dp" android:text="Portrait" android:textColor="@color/accent_primary" android:textSize="11sp" />
                </LinearLayout>
            </HorizontalScrollView>
        </FrameLayout>
        <LinearLayout android:id="@+id/pageChat" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:visibility="gone" android:padding="8dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingBottom="6dp">
                <TextView android:id="@+id/tvStatus" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Here with you" android:textColor="@color/accent_primary" android:textSize="12sp" android:textStyle="bold" />
                <TextView android:id="@+id/btnHistory" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="History &amp; Memory" android:textColor="@color/text_secondary" android:textSize="11sp" />
            </LinearLayout>
            <TextView android:id="@+id/tvActionLog" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_pill_dark" android:paddingHorizontal="10dp" android:paddingVertical="5dp" android:textColor="@color/status_green" android:textSize="11sp" android:visibility="gone" android:layout_marginBottom="6dp" />
            <ScrollView android:id="@+id/scrollConvo" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
                <TextView android:id="@+id/tvConversation" android:layout_width="match_parent" android:layout_height="wrap_content" android:lineSpacingExtra="4dp" android:text="আমি হুমায়রা — বলো বস, কী করতে হবে?" android:textColor="@color/text_primary" android:textSize="14sp" />
            </ScrollView>
        </LinearLayout>
        <LinearLayout android:id="@+id/pageVoiceOrb" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:background="#F2000000" android:visibility="gone">
            <View android:id="@+id/viewOrb" android:layout_width="136dp" android:layout_height="136dp" android:background="@drawable/bg_orb_glow" />
            <TextView android:id="@+id/tvOrbState" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Listening..." android:textColor="@color/text_primary" android:textSize="16sp" android:paddingTop="24dp" />
            <androidx.appcompat.widget.SwitchCompat android:id="@+id/swHandsFree" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hands-Free Loop " android:textColor="@color/text_secondary" android:paddingTop="12dp" />
            <TextView android:id="@+id/btnOrbClose" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_pill_dark" android:paddingHorizontal="18dp" android:paddingVertical="8dp" android:text="✕ Close Voice" android:textColor="@color/text_primary" android:layout_marginTop="16dp" />
        </LinearLayout>
    </FrameLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_card_dark" android:gravity="center_vertical" android:paddingHorizontal="8dp" android:paddingVertical="6dp" android:layout_marginTop="6dp">
        <TextView android:id="@+id/btnPlus" android:layout_width="34dp" android:layout_height="34dp" android:gravity="center" android:background="@drawable/bg_pill_dark" android:text="+" android:textColor="@color/text_primary" android:textSize="18sp" />
        <EditText android:id="@+id/etInput" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="Ask HUMAYRA..." android:textColorHint="@color/text_secondary" android:textColor="@color/text_primary" android:textSize="14sp" android:background="@android:color/transparent" android:paddingHorizontal="10dp" android:maxLines="3" />
        <TextView android:id="@+id/btnMic" android:layout_width="34dp" android:layout_height="34dp" android:gravity="center" android:text="🎤" android:textSize="16sp" android:layout_marginEnd="4dp" />
        <TextView android:id="@+id/btnActionOrb" android:layout_width="wrap_content" android:layout_height="36dp" android:minWidth="36dp" android:gravity="center" android:paddingHorizontal="12dp" android:background="@drawable/bg_glow_button" android:text="✦" android:textColor="#000000" android:textStyle="bold" android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
