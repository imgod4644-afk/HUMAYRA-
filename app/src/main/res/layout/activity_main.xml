<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg_main" android:padding="10dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:paddingBottom="8dp">
        <ImageView android:id="@+id/imgEmblem" android:layout_width="38dp" android:layout_height="38dp"
            android:src="@drawable/ic_humayra_emblem" android:contentDescription="Emblem" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:paddingStart="8dp" android:paddingEnd="4dp">
            <TextView android:id="@+id/tvName" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="HUMAYRA" android:textColor="@color/text_primary" android:textSize="15sp" android:textStyle="bold" />
            <TextView android:id="@+id/tvSubtitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="GODDESS OF AI" android:textColor="@color/accent_glow" android:textSize="10sp" android:letterSpacing="0.08" />
        </LinearLayout>
        <TextView android:id="@+id/tvModeBadge" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_dark" android:paddingHorizontal="9dp" android:paddingVertical="5dp"
            android:text="HYBRID" android:textColor="@color/status_green" android:textSize="11sp" android:layout_marginEnd="6dp" />
        <TextView android:id="@+id/tvHealthBadge" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_dark" android:paddingHorizontal="9dp" android:paddingVertical="5dp"
            android:text="🔋 --%" android:textColor="@color/text_primary" android:textSize="11sp" android:layout_marginEnd="6dp" />
        <TextView android:id="@+id/btnOverlay" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_dark" android:paddingHorizontal="9dp" android:paddingVertical="5dp"
            android:text="🫧" android:textSize="14sp" android:layout_marginEnd="6dp" />
        <TextView android:id="@+id/btnSettings" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_dark" android:paddingHorizontal="9dp" android:paddingVertical="5dp"
            android:text="⚙️" android:textSize="14sp" />
    </LinearLayout>
    <WebView android:id="@+id/webStage" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none" android:paddingVertical="6dp">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:id="@+id/btnPoseWave" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_pill_dark" android:paddingHorizontal="13dp" android:paddingVertical="6dp" android:text="Wave" android:textColor="@color/text_primary" android:textSize="12sp" android:layout_marginEnd="6dp" />
            <TextView android:id="@+id/btnPoseSit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_pill_dark" android:paddingHorizontal="13dp" android:paddingVertical="6dp" android:text="Sit" android:textColor="@color/text_primary" android:textSize="12sp" android:layout_marginEnd="6dp" />
            <TextView android:id="@+id/btnPoseStand" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_pill_dark" android:paddingHorizontal="13dp" android:paddingVertical="6dp" android:text="Stand" android:textColor="@color/text_primary" android:textSize="12sp" android:layout_marginEnd="6dp" />
            <TextView android:id="@+id/btnPoseSmile" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_pill_dark" android:paddingHorizontal="13dp" android:paddingVertical="6dp" android:text="Smile" android:textColor="@color/text_primary" android:textSize="12sp" android:layout_marginEnd="6dp" />
            <TextView android:id="@+id/btnPosePortrait" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_pill_dark" android:paddingHorizontal="13dp" android:paddingVertical="6dp" android:text="Portrait" android:textColor="@color/accent_primary" android:textSize="12sp" />
        </LinearLayout>
    </HorizontalScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_card_dark" android:orientation="vertical" android:padding="10dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <TextView android:id="@+id/tvStatus" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Here with you" android:textColor="@color/accent_primary" android:textSize="12sp" android:textStyle="bold" />
            <TextView android:id="@+id/btnHistory" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="History &amp; Memory" android:textColor="@color/text_secondary" android:textSize="11sp" android:paddingHorizontal="6dp" />
        </LinearLayout>
        <ScrollView android:id="@+id/scrollConvo" android:layout_width="match_parent" android:layout_height="88dp" android:layout_marginTop="4dp">
            <TextView android:id="@+id/tvConversation" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="OUR CONVERSATION\nহ্যালো বস! আমি হলাম হুমায়রা — বলো কী সাহায্য করব?" android:textColor="@color/text_primary" android:textSize="13sp" />
        </ScrollView>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginTop="6dp">
            <TextView android:id="@+id/btnTalk" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_pill_dark" android:paddingHorizontal="12dp" android:paddingVertical="9dp" android:text="🎤 Talk" android:textColor="@color/text_primary" android:textSize="12sp" />
            <EditText android:id="@+id/etInput" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="Type a command or chat..." android:textColorHint="@color/text_secondary" android:textColor="@color/text_primary" android:textSize="13sp" android:background="@android:color/transparent" android:paddingHorizontal="10dp" android:maxLines="3" />
            <TextView android:id="@+id/btnSend" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_glow_button" android:paddingHorizontal="14dp" android:paddingVertical="9dp" android:text="Send" android:textColor="#0B0E14" android:textStyle="bold" android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginTop="6dp">
            <TextView android:id="@+id/btnStop" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_pill_dark" android:paddingHorizontal="12dp" android:paddingVertical="5dp" android:text="⏹ Stop" android:textColor="@color/status_red" android:textSize="11sp" />
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            <androidx.appcompat.widget.SwitchCompat android:id="@+id/switchReadAloud" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:text="Read aloud " android:textColor="@color/text_secondary" android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
